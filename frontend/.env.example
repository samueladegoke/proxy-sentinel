# Proxy Sentinel Frontend Environment Configuration
# Copy this file to .env and update values as needed

# Backend API URL
VITE_API_URL=http://127.0.0.1:8000

# Do not add backend API tokens here. VITE_* values are bundled into browser code.
# If PROXY_SENTINEL_API_TOKEN is enabled on the backend, serve this dashboard behind
# a trusted server/session layer that adds credentials outside the client bundle.

# For production, use your deployed backend URL:
# VITE_API_URL=https://api.yourdomain.com

# Deployed Site URL
VITE_SITE_URL=https://proxy-sentinel.pages.dev/
