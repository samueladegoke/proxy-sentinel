# Proxy Sentinel Frontend Environment Configuration
# Copy this file to .env and update values as needed

# Backend API URL
VITE_API_URL=http://127.0.0.1:8000

# Optional. Use only for local/private deployments that enable PROXY_SENTINEL_API_TOKEN on the backend.
# Frontend VITE_* values are bundled into client code, so do not use this as a public-site secret.
# VITE_PROXY_SENTINEL_API_TOKEN=

# For production, use your deployed backend URL:
# VITE_API_URL=https://api.yourdomain.com

# Deployed Site URL
VITE_SITE_URL=https://proxy-sentinel.pages.dev/
